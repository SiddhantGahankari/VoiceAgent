{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "npm ci && npm run build",
  "functions": {
    "app.py": {
      "maxDuration": 90,
      "includeFiles": "backend/config.yaml",
      "excludeFiles": "{node_modules/**,.venv/**,.git/**,.vercel/**,.agents/**,.aws/**,.codex/**,.claude/**,.env,.env.*,__pycache__/**,**/__pycache__/**,*.pyc,**/*.pyc,.ruff_cache/**,.mypy_cache/**,*.tsbuildinfo,**/*.tsbuildinfo,*.zip,**/*.zip,*.log,**/*.log,*.md,**/*.md,skills-lock.json,src/**,index.html,vite.config.ts,tsconfig.json,package.json,package-lock.json}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "microphone=(self), camera=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self' wss: https:; media-src 'self' blob:; worker-src 'self' blob:; img-src 'self' data: https:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" }
      ]
    }
  ]
}
